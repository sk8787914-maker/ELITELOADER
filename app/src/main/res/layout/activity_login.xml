<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:id="@+id/loginRoot" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cyber_background">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/backgroundAnimation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.10"
        android:scaleType="centerCrop"
        app:lottie_rawRes="@raw/zoro"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_speed="0.8" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="18dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:padding="4dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ZORO LOADER" android:textColor="#F3F8F8" android:textSize="17sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="• SECURE ACCESS" android:textColor="#63D8E2" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="● ONLINE" android:textColor="#57E6A1" android:textSize="10sp" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="14dp"
                app:cardBackgroundColor="#160B1F24" app:cardCornerRadius="22dp" app:cardElevation="0dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/cyber_panel">
                    <ImageView android:id="@+id/logoImage" android:layout_width="148dp" android:layout_height="148dp" android:layout_alignParentTop="true" android:layout_centerHorizontal="true" android:layout_marginTop="8dp" android:contentDescription="Zoro Loader" android:scaleType="centerCrop" android:src="@drawable/zoro_badge" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true" android:layout_marginBottom="10dp" android:letterSpacing="0.18" android:text="Z O R O   L O A D E R" android:textColor="#21D8E8" android:textSize="20sp" android:textStyle="bold" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/cyber_panel" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACCESS CONSOLE" android:textColor="#F0F7F8" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Verify your license and enter the Edge workspace." android:textColor="#83A8AD" android:textSize="12sp" />
                <RelativeLayout android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp" android:background="@drawable/cyber_input">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:text="▣" android:textColor="#8CD8DE" android:textSize="19sp" />
                    <EditText android:id="@+id/userkey" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="32dp" android:layout_toStartOf="@id/showKey" android:background="@android:color/transparent" android:hint="LICENSE KEY" android:inputType="textPassword" android:maxLines="1" android:textColor="#E8FFFF" android:textColorHint="#709196" android:textSize="13sp" />
                    <ImageView android:id="@+id/paste" android:layout_width="30dp" android:layout_height="30dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:layout_marginEnd="38dp" android:padding="5dp" android:src="@drawable/baseline_content_paste_24" android:tint="#8CD8DE" />
                    <ImageView android:id="@+id/showKey" android:layout_width="30dp" android:layout_height="30dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:clickable="true" android:contentDescription="Show or hide license key" android:focusable="true" android:padding="5dp" android:src="@drawable/ic_visibility_off" android:tint="#8CD8DE" />
                </RelativeLayout>
                <Button android:id="@+id/login" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="14dp" android:background="@drawable/cyber_button_light" android:text="CONNECT TO DARK SERVER  ›" android:textColor="#18353A" android:textSize="14sp" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="♧  Encrypted local vault" android:textColor="#639BA0" android:textSize="11sp" />
                    <TextView android:id="@+id/GetKey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GET ACCESS  ›" android:textColor="#57DDE5" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/cyber_panel" android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="▣  DEVELOPER TEAM" android:textColor="#DAF7F8" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="API 24–36  •  ARM64" android:textColor="#5D9AA0" android:textSize="10sp" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="25dp" android:gravity="center" android:text="▰" android:textColor="#18D9E6" android:textSize="48sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="TEAM DARK DEVELOPER" android:textColor="#F4FFFF" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="PARALLAX   •   BABA TILLU   •   RAVI\nGON   •   HARSHU   •   DEVELOPER\nSHEEL CODER   •   PRIME   •   SHOOT360" android:textColor="#67D5DE" android:textSize="11sp" android:lineSpacingExtra="7dp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="SERVER ACCESS GATEWAY  •  v4.5.0" android:textColor="#52777C" android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
